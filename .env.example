# Copy this file to .env for local development.
# Never commit your real .env file.

# MongoDB connection string. For local dev: mongodb://127.0.0.1:27017/wedding
# For production: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/wedding?retryWrites=true&w=majority
MONGO_URI=

# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login credentials. Used by `npm run seed:admin` to create the bcrypt-hashed admin in MongoDB.
# These values are NOT served to the public — they only configure the protected /admin dashboard.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional. Render sets PORT automatically; locally, defaults to 5000.
# PORT=5000
